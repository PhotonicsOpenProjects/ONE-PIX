"""Lightweight i18n for the ONE-PIX Flask UI.

The active language is stored in a cookie (``onepix_lang``) so it survives
full-page navigations between blueprints. ``t(key)`` is registered as a
Jinja global (server-side static text) and is also the function backend
routes call directly for the few dynamic labels they render (e.g. settings
page titles). The same translation table for the active language is also
serialized to JSON and embedded in the page for client-side JS (toasts,
status labels, confirm dialogs) — see ``onepix-ui.js``'s ``ONEPIX.t()``.

Only UI chrome authored by this app is translated. Values that come from
the backend at runtime (hardware config keys, file names, plugin names,
imaging method names...) are never translated or guessed.
"""

from flask import request

SUPPORTED_LANGUAGES = ["en", "fr", "es", "de"]
DEFAULT_LANGUAGE = "en"
LANGUAGE_COOKIE = "onepix_lang"



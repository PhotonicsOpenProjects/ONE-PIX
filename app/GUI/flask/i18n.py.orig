def current_lang():
    """Active language for the current request, cookie-backed."""
    lang = request.cookies.get(LANGUAGE_COOKIE)
    return lang if lang in SUPPORTED_LANGUAGES else DEFAULT_LANGUAGE


def t(key):
    """Translate ``key`` into the current request's language.

    Falls back to English, then to the raw key, so a missing translation
    never breaks the page — it just shows untranslated (visible) text.
    """
    lang = current_lang()
    table = TRANSLATIONS.get(lang) or TRANSLATIONS[DEFAULT_LANGUAGE]
    return table.get(key) or TRANSLATIONS[DEFAULT_LANGUAGE].get(key) or key


def register_translations(plugin_translations):
    """Merge an external plugin's own vocabulary into ``TRANSLATIONS``.

    External blueprint plugins (e.g. fis_common_functions' Specific
    Analysis, spectral_indices_analysis) own their user-facing text
    instead of it being hardcoded here — this app only knows the core
    nav/acquisition/analysis/data/plugins chrome. Each plugin calls this
    once, at blueprint-creation time, with its own
    ``{lang: {key: value}}`` table.

    Keys should be namespaced per plugin (e.g. "specific.*", "indices.*")
    to avoid collisions — not enforced, just a convention. A plugin only
    needs to cover the languages it has translated; missing languages/keys
    still degrade gracefully through ``t()``'s English-then-raw-key
    fallback.
    """
    for lang, table in plugin_translations.items():
        TRANSLATIONS.setdefault(lang, {}).update(table)

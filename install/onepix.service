[Unit]
Description=ONE-PIX Flask application
After=graphical.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/ONE-PIX
ExecStart=/usr/bin/python3 -u /home/pi/ONE-PIX/app/GUI/flask/run.py
Environment=DISPLAY=:0
Environment=FLASK_DEBUG=0
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=graphical.target
